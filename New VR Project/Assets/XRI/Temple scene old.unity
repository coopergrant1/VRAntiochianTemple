  displayDrawing1: {fileID: 2037472510}
  blockTitle: 'AT067: Column Base'
  blockDescription: This block has the typical design of the Attic Ionic column base
    with the scotia-torus-scotia sequence. It provides a decorative transition between
    the vertical column and the horizontal stylobate.
  blockPlacement: 'It belonged to one of the columns of the temple. It was found
    the farthest away from the left side, and it is restored as the leftmost column
    base. '
  blockDrawing1: {fileID: 0}
